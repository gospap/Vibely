MONGODB_URI=your-mongodb-connection-string-here
SESSION_SECRET=your-session-secret-here

# Account created by `npm run seed`. The demo profiles it also creates all use
# the password "demo1234" - see seed.js.
SEED_USER_EMAIL=your-seed-account-email
SEED_USER_PASSWORD=your-seed-account-password

# --- Stripe (venue subscriptions) ---
# Leave STRIPE_SECRET_KEY unset to run without billing: /billing answers 503 and
# every venue stays on its trial.
STRIPE_SECRET_KEY=sk_test_...
# The recurring price each venue subscribes to, one subscription per venue.
STRIPE_PRICE_ID=price_...
# From `stripe listen --forward-to localhost:3000/stripe/webhook`, or the
# dashboard endpoint. Without it the webhook refuses every event.
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends the venue back after checkout or the billing portal.
CLIENT_URL=http://localhost:3000
